{
  "expo": {
    "name": "Star Map",
    "slug": "star-map",
    "owner": "ahmet909",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "starmap",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070d",
    "ios": {
      "bundleIdentifier": "com.ahmet.starmap",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Star Map uses your location to show the sky exactly as it looks where you are.",
        "NSMotionUsageDescription": "Star Map uses motion sensors so the sky follows your phone when you point it up.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ahmet.starmap",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Star Map uses your location to show the sky exactly as it looks where you are."
        }
      ],
      "./plugins/with-sky-bundle.js",
      "./plugins/with-scene-lifecycle.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ecf67b7-1aa7-4ec2-ad01-3119be3eb86c"
      }
    }
  }
}
